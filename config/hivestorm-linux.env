# HIVESTORM (CSA, 2026-11-17) - the Linux image.
#
# Image-scored, NOT CCDC: no red team, no Quotient, no scored accounts list.
# A scoring engine ON the image awards points for fixes and takes them away for
# breaking what the README requires. The README on the Desktop is the packet.
#
#     CFG=/tmp/ccdc-linux.env
#     sudo cp config/hivestorm-linux.env "$CFG" && sudo chmod 600 "$CFG"
#     sudo nano "$CFG"          # fill the three lists below FROM THE README
#     sudo ./linux/discover.sh --config "$CFG" --apply
#
# Run order: playbooks/hivestorm.md.

# --- who: copy these from the README, exactly --------------------------------------
# Every account the README names, admins AND standard users, plus root and YOUR
# login. Anything else is an unauthorized user - triage marks it RED.
CCDC_ALLOWED_USERS="root"
# Only the README's ADMINISTRATORS (plus your login if it is one). A standard
# user in sudo/wheel/admin is a scored finding; triage marks it RED when this is
# set. Leave it empty and admin rights are only checked against the list above.
CCDC_ALLOWED_ADMINS=""
# The README's users who log in. Triage raises RED if one is locked or loses
# its shell, and passwords.sh rotates exactly these - weak passwords score.
CCDC_INTERACTIVE_USERS=""
# Optional: the image's known weak password, so passwords.sh refuses it.
CCDC_PACKET_PASSWORD=""

# --- what: discover.sh fills these; the README's "critical services" decide ------
# If the README names a service (ssh, apache2, vsftpd, samba...) it must still
# answer when you are done. Put its unit here so harden.sh checks it after every
# cut, and in PROTECT so services.sh never offers it.
CCDC_SYSTEMD_SERVICES=""
CCDC_PROTECT_SERVICES=""
CCDC_ALLOWED_TCP_PORTS="22"
CCDC_ALLOWED_UDP_PORTS=""
CCDC_TCP_CHECKS=""
CCDC_HTTP_CHECKS=""

# --- firewall: turning it on scores; cutting the scoring engine off does not ------
# The engine reports to a server over the internet. Outbound stays OPEN, always.
CCDC_ALLOWED_SOURCES=""
CCDC_ALLOW_OUTBOUND="1"
CCDC_FIREWALL_BACKEND="auto"
# ufw is the usual Ubuntu image firewall and enabling it is the scored item.
# If fw.sh refuses because ufw is active, `sudo ufw enable` + `ufw allow <port>`
# is the simpler path tonight.
CCDC_ACK_REPLACE_MANAGED_FIREWALL="0"
CCDC_FIREWALL_ROLLBACK_SECONDS="120"

# --- SSH: every one of these is a classic scored item -----------------------------
CCDC_SSH_PERMIT_ROOT_LOGIN="no"
CCDC_SSH_PASSWORD_AUTH=""             # leave: README users log in with passwords
CCDC_SSH_PERMIT_EMPTY_PASSWORDS="no"
CCDC_SSH_PERMIT_USER_ENV="no"
CCDC_SSH_MAX_AUTH_TRIES="4"
CCDC_SSH_LOGIN_GRACE="30"
CCDC_SSH_X11_FORWARDING="no"
CCDC_SSH_ALLOW_USERS=""
CCDC_SSH_ROLLBACK_SECONDS="120"

# --- password policy: no spray to fear, so the textbook values ----------------------
# No Linux tool applies these (only passwords.sh reads the minimum length).
# They are the TARGETS for the edits policy.sh prints: login.defs
# PASS_MAX_DAYS/PASS_MIN_DAYS, pam_pwquality minlen, pam_pwhistory remember,
# pam_faillock deny/unlock_time. Apply them by hand tonight - they are points.
CCDC_PW_MIN_LENGTH="12"
CCDC_PW_MAX_AGE="90"
CCDC_PW_HISTORY="5"
CCDC_LOCKOUT_THRESHOLD="5"
CCDC_LOCKOUT_DURATION="30"
