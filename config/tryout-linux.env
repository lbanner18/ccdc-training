# BYU CCDC tryout, 2026-09-26 - the "Mojank Studios" packet.
# Linux boxes: iron (Ubuntu 18.04) and redstone (Rocky 9.6 + Splunk Enterprise).
#
# Copy it OFF the repo first - the repo is public, your copy will not be:
#     CFG=/tmp/ccdc-linux.env
#     cp config/tryout-linux.env "$CFG" && chmod 600 "$CFG"
# Then let the box fill in its own half (services, ports, checks):
#     sudo ./linux/discover.sh --config "$CFG" --apply
#
# No passwords in here, not even the packet's default. They live on paper.

# --- who: the packet's "should have, and only have" list ------------------------
# root is not in the packet but every Linux box has it; it is the one allowed
# account that is not scored. Your backup admin is added here automatically by
# users.sh --create-admin.
CCDC_ALLOWED_USERS="root steve alex enderman creeper villager zombie enderdragon irongolem chickenjockey ghast"

# The scored accounts. The scorer logs in as these, so they must stay usable:
# triage raises RED if one is locked, expired or loses its shell, and
# passwords.sh rotates exactly these from the block you give Quotient.
CCDC_INTERACTIVE_USERS="steve alex enderman creeper villager zombie enderdragon irongolem chickenjockey ghast"

# Optional: the packet's default password, so passwords.sh refuses to "rotate"
# an account back onto it. Type it in your COPY on the day; never commit it.
CCDC_PACKET_PASSWORD=""

# --- what: filled by discover.sh from what this box actually runs ----------------
# The packet scores HTTP, SSH, FTP, AD/DNS and POP3 "potentially on Windows or
# Linux" without saying which box has which. discover.sh writes these lines in
# a marked block at the end of your copy; Quotient's service list at 9:00 is
# the authority on which of them are scored.
CCDC_SYSTEMD_SERVICES=""
CCDC_ALLOWED_TCP_PORTS="22"
CCDC_ALLOWED_UDP_PORTS=""
CCDC_TCP_CHECKS=""
CCDC_HTTP_CHECKS=""

# --- rules that bind this file ----------------------------------------------------
# Rule 4: public services must answer EVERY source address; no IP blocking, no
# rules that admit only the scoring engine. This stays empty.
CCDC_ALLOWED_SOURCES=""
# The forwarders must keep reaching both indexers - the rules forbid disabling
# forwarding to the Black Team's. Outbound stays open.
CCDC_ALLOW_OUTBOUND="1"
CCDC_FIREWALL_BACKEND="auto"          # nft, iptables (18.04) or firewalld (Rocky), whichever runs
CCDC_FIREWALL_ROLLBACK_SECONDS="60"

# --- SSH: scored, so the scorer must still get in with a password ------------------
CCDC_SSH_PERMIT_ROOT_LOGIN="no"
CCDC_SSH_PASSWORD_AUTH=""             # leave: the scorer logs in with a password
CCDC_SSH_PERMIT_EMPTY_PASSWORDS="no"
CCDC_SSH_PERMIT_USER_ENV="no"
CCDC_SSH_MAX_AUTH_TRIES="4"
CCDC_SSH_LOGIN_GRACE="30"
CCDC_SSH_X11_FORWARDING="no"
CCDC_SSH_ALLOW_USERS=""               # leave: an allow-list would lock scored accounts out
CCDC_SSH_ROLLBACK_SECONDS="120"

# --- lockout: the usernames are in the packet, so a spray can lock them ------------
CCDC_LOCKOUT_THRESHOLD="10"
CCDC_LOCKOUT_DURATION="2"

# --- the disguise: choose these ON THE DAY, and not in any repo --------------------
# The kit is public, so its default unit names are public too. Uncomment and
# pick two names only you know - something that would not look out of place in
# `systemctl list-units` on a server, and does not collide with a real unit:
#     systemctl list-unit-files | grep -i NAME     # must print nothing
# CCDC_SENTRY_NAME=""
# CCDC_GUARDIAN_NAME=""
