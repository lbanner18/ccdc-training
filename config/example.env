# Copy this file to a local path such as /tmp/ccdc-linux.env.
# Never commit the filled-in copy.

CCDC_BOX_NAME="linux-target"
CCDC_EVIDENCE_DIR="/var/tmp/ccdc-evidence"
CCDC_BACKUP_DIR="/var/backups/ccdc"

# Space-separated account names that must remain usable. Include the account
# you are using to administer the box and every scored/service account.
CCDC_ALLOWED_USERS="root"

# Space-separated glob patterns that baseline.sh treats as explained forever,
# even though no package owns them and they are not in the blessed baseline.
#
# You will rarely need this. The normal way to say "this one is mine" is
#   sudo ./linux/baseline.sh --config FILE --allow WHAT --reason TEXT --apply
# which records the exception WITH a timestamp and your reason - and that
# reason is a line you can paste into the inject that asked for the change.
# This variable is for the standing ones you know about before the competition
# starts, where writing them down once beats approving them every round.
#
# A pattern matches either the subject on its own or kind:subject, so you can
# scope it. Be specific: "/opt/*" explains an entire directory forever, which
# is how a baseline stops being a baseline.
#
#   CCDC_BASELINE_ALLOW="/opt/vendor-agent/bin/agent unit:/etc/systemd/system/vendor-agent.service"
CCDC_BASELINE_ALLOW=""

# Space-separated explicit targets for users.sh. Leave empty until the packet
# identifies accounts that may be disabled or have passwords rotated.
CCDC_MANAGED_USERS=""
CCDC_ROTATE_USERS=""

# Space-separated systemd units that watchdog may restart.
CCDC_SYSTEMD_SERVICES=""

# --- Attack surface (services.sh) -------------------------------------------
# Units services.sh must never disable, on top of the ones it already protects
# (scored services above, this kit's own units, sshd, cron, DNS, logging, the
# firewall). Put anything here the packet says is scored but that looks
# disposable -- listing it is how you acknowledge the risk deliberately.
CCDC_PROTECT_SERVICES=""

# Units to actually disable. Leave EMPTY until you have run
#     ./linux/services.sh --config <cfg> --review
# and decided for yourself. services.sh will not choose for you: the review
# suggests, this list acts. Everything disabled is recorded and reversible with
# --revert, and the tool refuses anything protected or scored-looking.
CCDC_DISABLE_SERVICES=""

# A second, explicit acknowledgement for a unit that services.sh classifies as
# likely scored but the packet proves is disposable. Do NOT put it in
# CCDC_PROTECT_SERVICES: protected means the tool must never touch it.
CCDC_ACK_DISABLE_LIKELY_SCORED=""

# One check per line, format: name|host|port|systemd-service. These are TCP
# checks. The service field may be empty when failure should only be logged;
# when present, watchdog restarts it and verifies recovery with the same TCP
# probe. This catches a hung daemon whose systemd unit still says "active".
CCDC_TCP_CHECKS=""

# One check per line, format: name|url|systemd-service. The service field may
# be empty when a failed URL should only be logged.
CCDC_HTTP_CHECKS=""

# Files whose contents should remain stable. One absolute path per line.
CCDC_HASH_FILES="/etc/ssh/sshd_config"

# Allowed inbound ports, split by protocol. Examples: "22 80 443".
#
# fw.sh turns these into rules. triage.sh also reads them twice over: a listening
# port outside these lists is a finding, and - more importantly - an INTERPRETER
# holding a port inside them is downgraded to AMBER, because a scored service is
# allowed to be a Python or PHP app. Getting these right is what keeps the
# reverse-shell check from crying wolf at the one service you must not kill.
#
# UDP is usually empty, and that is fine: triage allows the handful of ports a
# stock install binds (DHCP, NTP, mDNS, CUPS, portmap) plus the kernel's
# ephemeral range, so an empty list does not mean a page of findings.
CCDC_ALLOWED_TCP_PORTS="22"
CCDC_ALLOWED_UDP_PORTS=""

# --- External perimeter scan (workstation/perimeter.sh) --------------------
# This runs ONLY from the external workstation the inject assigns, never from
# a scored target. Set the exact assigned IPv4 CIDR from the packet; the tool
# accepts /16 through /32 only and refuses an empty, hostname, or broad target.
# It requires both
# --apply and --confirm-scope before it sends any packets.
CCDC_PERIMETER_SCOPE=""
# Evidence lives on the workstation, not in the target's root-owned directory.
CCDC_PERIMETER_EVIDENCE_DIR="/tmp/ccdc-perimeter"
# Conservative caps. Do not raise them on a small competition network.
CCDC_PERIMETER_TCP_RATE="1000"
CCDC_PERIMETER_UDP_RATE="100"

# Optional addresses that must be able to reach the box (scorer, Splunk,
# administrator). Keep this empty until the team packet supplies the values.
CCDC_ALLOWED_SOURCES=""

# Paths to preserve, one per line. Use absolute paths and only add what the
# packet or service actually requires.
CCDC_BACKUP_PATHS="
/etc/ssh/sshd_config
/etc/passwd
/etc/group
/etc/sudoers
"

# Firewall settings. CCDC_ALLOW_OUTBOUND=0 is safer for reverse-shell control
# but may break DNS, package updates, or a scored service. Test it in the lab.
CCDC_FIREWALL_BACKEND="auto"
CCDC_ALLOW_OUTBOUND="1"
CCDC_FIREWALL_ROLLBACK_SECONDS="60"
# fw.sh replaces the backend ruleset. If firewalld, ufw, or Docker is active it
# refuses apply unless you explicitly acknowledge that their policy/NAT rules
# will be replaced. Prefer integrating with that manager when it is scored.
CCDC_ACK_REPLACE_MANAGED_FIREWALL="0"

# --- Canaries (canary.sh) ---------------------------------------------------
# Decoy files to lay, one absolute path per line. Leave unset to use the
# built-in defaults (the files an attacker greps for first). Access to any of
# these is a high-confidence intrusion signal.
CCDC_CANARY_FILES=""

# Real files whose access should be watched via auditd, one path per line.
# Leave unset for the sensible default set (passwd, shadow, sudoers, cron,
# authorized_keys).
CCDC_CANARY_WATCH_PATHS=""

# --- Scanning (scan.sh) and banners (banner.sh) -----------------------------
# Where scan.sh looks when no --path is given. Deliberately the directories a
# payload lands in, not the whole filesystem: scanning / with a clock running
# spends twenty minutes for an answer nobody reads.
CCDC_SCAN_PATHS=""
CCDC_YARA_RULES=""                 # a rules file; yara with no rules does nothing

# Banner text. Leave empty for the built-in notice, which states monitoring and
# consent, does not say "welcome" (argued in court as an invitation), and names
# no OS or version - a banner that leaks the distribution is free recon printed
# before authentication.
CCDC_BANNER_FILE=""

# --- SSH policy (sshd.sh) ---------------------------------------------------
# EVERY value here is optional, and empty means "leave what the box already does
# alone". That is deliberate: this is the one config on the box where a change
# you did not intend ends your session, and a tool that writes defaults you did
# not choose is a tool that eventually locks someone out.
#
# sshd.sh writes these into a drop-in, validates with `sshd -t`, arms a timed
# rollback, and only then reloads. Test the new login in a SECOND terminal
# before running --confirm.
CCDC_SSHD_CONFIG="/etc/ssh/sshd_config"
CCDC_SSHD_DROPIN_DIR="/etc/ssh/sshd_config.d"

CCDC_SSH_PERMIT_ROOT_LOGIN="no"
# LEAVE THIS EMPTY unless the packet says key-only. The scoring engine may log
# in with a password, and "hardening" that away is downtime you caused. sshd.sh
# refuses to set it to "no" unless an allowed account already has a working
# authorized_keys - but it cannot know what the scorer does.
CCDC_SSH_PASSWORD_AUTH=""
CCDC_SSH_PERMIT_EMPTY_PASSWORDS="no"
CCDC_SSH_PERMIT_USER_ENV="no"
CCDC_SSH_MAX_AUTH_TRIES="4"
CCDC_SSH_LOGIN_GRACE="30"
CCDC_SSH_X11_FORWARDING="no"
CCDC_SSH_ALLOW_TCP_FORWARDING=""
CCDC_SSH_CLIENT_ALIVE_INTERVAL=""
# An allow-list of accounts that may log in at all. Powerful and easy to get
# wrong: sshd.sh refuses to apply one that does not include the account you are
# using. Leave empty until you know every account that must keep working,
# INCLUDING any the scoring engine logs in as.
CCDC_SSH_ALLOW_USERS=""
# How long you have to prove a new login works before the config reverts
# itself. Minimum 60: a window you cannot finish the test inside is a window
# that reverts a good change.
CCDC_SSH_ROLLBACK_SECONDS="120"

# Pre-login banner served by SSH. banner.sh writes the FILE; this directive is
# what makes sshd show it, and it lives here so it goes through the same
# validation and rollback as every other SSH change. sshd refuses to start if
# this names a file that does not exist, so sshd.sh checks that first.
CCDC_SSH_BANNER=""

# --- Log forwarding (splunk.sh) ---------------------------------------------
# Where the forwarder is installed. Leave empty to auto-detect the usual paths
# and, failing that, to ask a running splunkd where it lives.
CCDC_SPLUNK_HOME=""

# Indexers this box must reach, "host:port" (9997 is the usual forwarder port).
# These are checked IN ADDITION to whatever outputs.conf says, so a forwarder
# that has quietly lost its output group is still measured against the packet.
CCDC_SPLUNK_INDEXERS=""

# Logs that must be forwarded. Anything here that exists on the box and is not
# a monitored input is a finding. Leave empty for the usual set (auth/secure,
# audit.log, syslog/messages).
CCDC_SPLUNK_REQUIRED_PATHS=""

# Where --test-event writes its tagged line. Leave empty to use logger(1) and
# the system log. Set it to a file you KNOW is a monitored input when syslog is
# not one: a probe that proves delivery from the wrong file proves nothing.
CCDC_SPLUNK_TEST_TARGET=""

# --- Audit and logging (audit.sh) -------------------------------------------
# canary.sh loads its watches with `auditctl -w`, which lives only in the
# kernel: one `systemctl restart auditd` and every watch is gone while the disk
# looks untouched. audit.sh owns the persistent half, in rules.d, which auditd
# re-reads on every start.
#
# Leave these at the defaults unless the box puts audit rules somewhere unusual.
CCDC_AUDIT_RULES_DIR="/etc/audit/rules.d"
CCDC_AUDIT_RULES_FILE=""           # empty -> $CCDC_AUDIT_RULES_DIR/60-ccdc.rules

# Login records get write watches. These are low-volume and high-value: an
# attacker editing wtmp/btmp is covering their tracks. /var/log/auth.log is
# deliberately NOT here - sshd and sudo write to it constantly, and a write
# watch on it buries every real finding under its own noise.
CCDC_AUDIT_LOGIN_RECORDS=""        # empty -> wtmp, btmp, lastlog

# Log every command run by a real user (auid >= 1000). This is the rule that
# records a reverse shell's command line, and it is also the highest-volume
# rule in common use - on a busy box it can fill a disk. Off by default; turn it
# on once you have seen how much the box actually generates.
CCDC_AUDIT_EXECVE="0"

# Logs whose size and inode are compared between passes. A log that SHRANK
# without rotating is truncation, and truncation is someone starting the record
# over. Leave empty for the usual set (auth/secure, syslog/messages, audit.log,
# wtmp, btmp).
CCDC_LOG_PATHS=""
CCDC_LOG_CAPTURE_LINES="5000"      # tail size for --capture

# --- Guardian (guardian.sh) -------------------------------------------------
# The name every installed artifact takes: <name>.service, <name>-watch.service,
# <name>-reconcile.timer, /etc/cron.d/<name>. Pick something plausible for the
# box rather than something that advertises itself. Must be [A-Za-z0-9_-] only,
# because cron silently ignores any other filename in /etc/cron.d.
CCDC_GUARDIAN_NAME="node-health"

# Each layer can be named independently. Leave these empty and they derive from
# CCDC_GUARDIAN_NAME above, which is convenient and also means ONE grep finds
# your entire defence:
#     systemctl list-units | grep node-health
#     rm /etc/systemd/system/node-health*        <- removes every layer at once
# Set them to unrelated, plausible-looking names and an attacker has to discover
# four separate things instead of one pattern. Your manifest still lists them
# all, so you do not lose track of your own artifacts.
# Pick names that suit the box; these are examples, not recommendations.
CCDC_GUARDIAN_WATCH_NAME=""        # e.g. "systemd-netmon"
CCDC_GUARDIAN_TICKER_NAME=""       # e.g. "polkit-refresh"
CCDC_GUARDIAN_RECONCILE_NAME=""    # e.g. "man-db-sync"
CCDC_GUARDIAN_CRON_NAME=""         # e.g. "sysstat-aux"

# Where the guardian keeps its own copy of guardian.sh, watchdog.sh,
# lib/common.sh and this config, so it does not depend on your checkout or on a
# /tmp config surviving. Leave empty for /usr/local/lib/$CCDC_GUARDIAN_NAME.
#
# If you set per-layer names above, set this to something unrelated as well:
# every layer's ExecStart names this directory, so
#     grep -rl "<this dir>" /etc/systemd/system /etc/cron.d
# finds all of them at once. Renaming the units but leaving the directory as
# node-health puts the shared thread straight back.
CCDC_GUARDIAN_DIR=""               # e.g. "/usr/local/lib/netmon"

# Where this chain keeps its manifest, disarm sentinel, lock and log. Leave
# empty to use CCDC_EVIDENCE_DIR, which is right when you run ONE guardian.
#
# Set it to run SEVERAL INDEPENDENT CHAINS. Copy this config, give the copy its
# own CCDC_GUARDIAN_*_NAME values, its own CCDC_GUARDIAN_DIR and its own state
# dir, and install it as well. You then have two complete keep-alives that share
# no unit name, no payload directory and no state file -- so an attacker who
# finds and removes one has removed one, and the other rebuilds nothing of the
# first chain's because it does not know it exists.
#
# Without this, the second install overwrites the first chain's manifest, and
# --uninstall then tears down a list of artifacts that is no longer the list
# that is actually on the box.
CCDC_GUARDIAN_STATE_DIR=""         # e.g. "/var/lib/misc/.netmon"

# Independently hash and repair sentry's unit, installed config, ownership
# marker, and every regular file in its installed tree. "auto" enrolls sentry
# when guardian --install sees a valid sentry installation, remembers that
# enrollment in the guardian manifest, and otherwise permits a deliberate
# arm.sh --skip-sentry deployment. Use 0 only when another mechanism owns
# sentry integrity. Re-run sentry --install immediately before guardian
# --install when intentionally updating the sentry payload.
CCDC_GUARDIAN_PROTECT_SENTRY="auto"

# Also put the persistent audit rules back every tick, from a private copy of
# audit.sh that travels with the guardian payload.
#
# This is guardian's job rather than sentry's because restoring OUR OWN
# detection to its declared state is not a change to the box's security posture
# - it is the same category as guardian rebuilding one of its own deleted units,
# and it needs no operator sign-off. Anything that changes the BOX's
# configuration still goes through sentry and a human.
#
#   auto  repair when audit.sh is available (the default)
#   1     require it; refuse to install without it
#   0     leave the audit rules to the operator
CCDC_GUARDIAN_REPAIR_AUDIT="auto"
CCDC_GUARDIAN_AUDIT_FILE=""        # empty -> <reconcile-name>-audit.sh

# NOTE: do NOT give each chain its own CCDC_EVIDENCE_DIR. The watchdog's
# singleton lock lives there, and that shared lock is what keeps exactly one
# watchdog restarting services. Two watchdogs restarting the same service is not
# redundancy -- the second restart is an outage you caused yourself. Losing
# chains idle as hot standbys and take over within
# CCDC_WATCHDOG_STANDBY_SECONDS if the active one is killed.
CCDC_WATCHDOG_STANDBY_SECONDS="5"

# Seconds between reconcile passes. This is the window an attacker has to remove
# all three layers at once; shorter is more resilient and noisier. The cron
# layer rounds up to whole minutes, so below 60 only the systemd layers actually
# tick at this rate.
CCDC_GUARDIAN_INTERVAL="60"

# Seconds between WATCHDOG passes. Different job, different number: the interval
# above decides how fast a deleted layer is rebuilt, this one decides how fast a
# dead service is noticed, and only this one converts into scored downtime. Your
# mean outage is roughly half of it. Measured on the lab box against an external
# scorer, the same `systemctl stop` cost 57s at 60 and 6s at 5.
#
# A pass is a curl and a couple of systemctl calls, and watchdog.sh already
# limits itself to one restart per service per pass with a settle deadline after
# each, so a short interval is not a restart storm. Leave empty to inherit
# CCDC_GUARDIAN_INTERVAL. Floor is 2.
CCDC_WATCHDOG_INTERVAL="5"

# How often the watchdog writes a "still alive" line when nothing is wrong. The
# log otherwise records only state CHANGES, so a quiet hour is silent -- which
# is what makes a short interval affordable to read, but also means you need
# some proof the loop is still running.
CCDC_WATCHDOG_HEARTBEAT_SECONDS="300"

# --- Sentry (sentry.sh) -----------------------------------------------------
# arm.sh installs this as a supervised service. It runs ranked triage often,
# runs the larger canary+hunt+recon sweep less often, and keeps a CURRENT
# approval queue in $CCDC_EVIDENCE_DIR/ALERTS. It never approves its own work.
CCDC_SENTRY_NAME="ccdc-sentry"
CCDC_SENTRY_DIR=""                 # empty -> /usr/local/lib/$CCDC_SENTRY_NAME
CCDC_SENTRY_INTERVAL="60"
CCDC_WATCH_INTERVAL="120"
# New RED baseline findings are broadcast once to logged-in terminals with
# `wall` when it is installed. Set to 0 only when another team procedure owns
# operator notification; this never sends email or traffic off the box.
CCDC_WATCH_NOTIFY="1"
# Hard deadlines for one triage pass and one full canary/hunt/recon sweep.
# Without these, one wedged NSS lookup, filesystem walk, or package verifier
# could leave the sentry process "active" while its queue silently went stale.
CCDC_TRIAGE_TIMEOUT="45"
CCDC_WATCH_TIMEOUT="90"

# =============================================================================
# WINDOWS
# =============================================================================
#
# This is the SAME FILE the Windows tools read. One worksheet, one format, both
# boxes - because a competition where you keep two config formats straight at
# hour four is a competition you lose to your own notes.
#
# Copy it to the Windows box as C:\ProgramData\CCDC\ccdc.env and fill in the
# Windows section. The Linux keys above are ignored there and vice versa.

# --- What you are scored on (windows/*.ps1) ---------------------------------
#
# Service NAMES, not display names. Get the name from:
#     Get-Service | Select-Object Name,DisplayName,Status
#
# "World Wide Web Publishing Service" is DisplayName; W3SVC is what goes here.
#
# The Windows tools REFUSE to act while this and CCDC_ALLOWED_USERS are empty.
# An empty list does not mean nothing is protected, it means nothing has told
# the tool what is scored.
CCDC_WINDOWS_SERVICES=""

# Services to stop and disable. Named explicitly, never guessed - a tool that
# infers which service is unnecessary eventually infers the scored one.
#
# Worth considering once you have read what each does, and once the packet has
# ruled them out:
#     RemoteRegistry   remote registry editing; almost never needed
#     Spooler          the print spooler (PrintNightmare); needed only if printing
#     SSDPSRV          UPnP discovery
#     upnphost         UPnP host
#     WinRM            PowerShell remoting - CHECK FIRST, you may be using it
#     Fax, TapiSrv     telephony
CCDC_WINDOWS_DISABLE_SERVICES=""

# Is RDP one of the scored services? "1" = yes, leave it alone and harden it.
# "0" = not scored, and harden.ps1 may turn it off entirely - but only when you
# also pass -IHaveConsoleAccess, because turning RDP off over RDP ends the
# session and the box is console-only afterwards.
CCDC_RDP_SCORED="1"

# --- Password policy (windows/harden.ps1 -Only PasswordPolicy) --------------
#
# These are also the answer to the password-policy inject, so whatever you set,
# be able to say WHY. Current guidance (NIST SP 800-63B) is length over
# complexity, no forced rotation, and blocking known-breached passwords -
# which is why the default max age here is 0 rather than 90.
CCDC_PW_MIN_LENGTH="14"
CCDC_PW_MAX_AGE="0"
CCDC_PW_HISTORY="10"

# Lockout is a trade. It stops password guessing, and it is also how somebody
# locks your SCORED accounts out on purpose. A threshold of 10 with a short
# duration is the compromise; 3 attempts and 30 minutes is a denial of service
# waiting to be used against you.
CCDC_LOCKOUT_THRESHOLD="10"
CCDC_LOCKOUT_DURATION="15"
