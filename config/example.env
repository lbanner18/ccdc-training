# Copy this file to a local path such as /tmp/ccdc-linux.env.
# Never commit the filled-in copy.

CCDC_BOX_NAME="linux-target"
CCDC_EVIDENCE_DIR="/var/tmp/ccdc-evidence"
CCDC_BACKUP_DIR="/var/backups/ccdc"

# Space-separated account names that must remain usable. Include the account
# you are using to administer the box and every scored/service account.
CCDC_ALLOWED_USERS="root"

# Space-separated explicit targets for users.sh. Leave empty until the packet
# identifies accounts that may be disabled or have passwords rotated.
CCDC_MANAGED_USERS=""
CCDC_ROTATE_USERS=""

# Space-separated systemd units that watchdog may restart.
CCDC_SYSTEMD_SERVICES=""

# --- Attack surface (services.sh) -------------------------------------------
# Units services.sh must never disable, on top of the ones it already protects
# (scored services above, this kit's own units, sshd, cron, DNS, logging, the
# firewall). Put anything here the packet says is scored but that looks
# disposable -- listing it is how you acknowledge the risk deliberately.
CCDC_PROTECT_SERVICES=""

# Units to actually disable. Leave EMPTY until you have run
#     ./linux/services.sh --config <cfg> --review
# and decided for yourself. services.sh will not choose for you: the review
# suggests, this list acts. Everything disabled is recorded and reversible with
# --revert, and the tool refuses anything protected or scored-looking.
CCDC_DISABLE_SERVICES=""

# A second, explicit acknowledgement for a unit that services.sh classifies as
# likely scored but the packet proves is disposable. Do NOT put it in
# CCDC_PROTECT_SERVICES: protected means the tool must never touch it.
CCDC_ACK_DISABLE_LIKELY_SCORED=""

# One check per line, format: name|host|port|systemd-service. These are TCP
# checks. The service field may be empty when failure should only be logged;
# when present, watchdog restarts it and verifies recovery with the same TCP
# probe. This catches a hung daemon whose systemd unit still says "active".
CCDC_TCP_CHECKS=""

# One check per line, format: name|url|systemd-service. The service field may
# be empty when a failed URL should only be logged.
CCDC_HTTP_CHECKS=""

# Files whose contents should remain stable. One absolute path per line.
CCDC_HASH_FILES="/etc/ssh/sshd_config"

# Allowed inbound ports, split by protocol. Examples: "22 80 443".
#
# fw.sh turns these into rules. triage.sh also reads them twice over: a listening
# port outside these lists is a finding, and - more importantly - an INTERPRETER
# holding a port inside them is downgraded to AMBER, because a scored service is
# allowed to be a Python or PHP app. Getting these right is what keeps the
# reverse-shell check from crying wolf at the one service you must not kill.
#
# UDP is usually empty, and that is fine: triage allows the handful of ports a
# stock install binds (DHCP, NTP, mDNS, CUPS, portmap) plus the kernel's
# ephemeral range, so an empty list does not mean a page of findings.
CCDC_ALLOWED_TCP_PORTS="22"
CCDC_ALLOWED_UDP_PORTS=""

# Optional addresses that must be able to reach the box (scorer, Splunk,
# administrator). Keep this empty until the team packet supplies the values.
CCDC_ALLOWED_SOURCES=""

# Paths to preserve, one per line. Use absolute paths and only add what the
# packet or service actually requires.
CCDC_BACKUP_PATHS="
/etc/ssh/sshd_config
/etc/passwd
/etc/group
/etc/sudoers
"

# Firewall settings. CCDC_ALLOW_OUTBOUND=0 is safer for reverse-shell control
# but may break DNS, package updates, or a scored service. Test it in the lab.
CCDC_FIREWALL_BACKEND="auto"
CCDC_ALLOW_OUTBOUND="1"
CCDC_FIREWALL_ROLLBACK_SECONDS="60"
# fw.sh replaces the backend ruleset. If firewalld, ufw, or Docker is active it
# refuses apply unless you explicitly acknowledge that their policy/NAT rules
# will be replaced. Prefer integrating with that manager when it is scored.
CCDC_ACK_REPLACE_MANAGED_FIREWALL="0"

# --- Canaries (canary.sh) ---------------------------------------------------
# Decoy files to lay, one absolute path per line. Leave unset to use the
# built-in defaults (the files an attacker greps for first). Access to any of
# these is a high-confidence intrusion signal.
CCDC_CANARY_FILES=""

# Real files whose access should be watched via auditd, one path per line.
# Leave unset for the sensible default set (passwd, shadow, sudoers, cron,
# authorized_keys).
CCDC_CANARY_WATCH_PATHS=""

# --- Guardian (guardian.sh) -------------------------------------------------
# The name every installed artifact takes: <name>.service, <name>-watch.service,
# <name>-reconcile.timer, /etc/cron.d/<name>. Pick something plausible for the
# box rather than something that advertises itself. Must be [A-Za-z0-9_-] only,
# because cron silently ignores any other filename in /etc/cron.d.
CCDC_GUARDIAN_NAME="node-health"

# Each layer can be named independently. Leave these empty and they derive from
# CCDC_GUARDIAN_NAME above, which is convenient and also means ONE grep finds
# your entire defence:
#     systemctl list-units | grep node-health
#     rm /etc/systemd/system/node-health*        <- removes every layer at once
# Set them to unrelated, plausible-looking names and an attacker has to discover
# four separate things instead of one pattern. Your manifest still lists them
# all, so you do not lose track of your own artifacts.
# Pick names that suit the box; these are examples, not recommendations.
CCDC_GUARDIAN_WATCH_NAME=""        # e.g. "systemd-netmon"
CCDC_GUARDIAN_TICKER_NAME=""       # e.g. "polkit-refresh"
CCDC_GUARDIAN_RECONCILE_NAME=""    # e.g. "man-db-sync"
CCDC_GUARDIAN_CRON_NAME=""         # e.g. "sysstat-aux"

# Where the guardian keeps its own copy of guardian.sh, watchdog.sh,
# lib/common.sh and this config, so it does not depend on your checkout or on a
# /tmp config surviving. Leave empty for /usr/local/lib/$CCDC_GUARDIAN_NAME.
#
# If you set per-layer names above, set this to something unrelated as well:
# every layer's ExecStart names this directory, so
#     grep -rl "<this dir>" /etc/systemd/system /etc/cron.d
# finds all of them at once. Renaming the units but leaving the directory as
# node-health puts the shared thread straight back.
CCDC_GUARDIAN_DIR=""               # e.g. "/usr/local/lib/netmon"

# Where this chain keeps its manifest, disarm sentinel, lock and log. Leave
# empty to use CCDC_EVIDENCE_DIR, which is right when you run ONE guardian.
#
# Set it to run SEVERAL INDEPENDENT CHAINS. Copy this config, give the copy its
# own CCDC_GUARDIAN_*_NAME values, its own CCDC_GUARDIAN_DIR and its own state
# dir, and install it as well. You then have two complete keep-alives that share
# no unit name, no payload directory and no state file -- so an attacker who
# finds and removes one has removed one, and the other rebuilds nothing of the
# first chain's because it does not know it exists.
#
# Without this, the second install overwrites the first chain's manifest, and
# --uninstall then tears down a list of artifacts that is no longer the list
# that is actually on the box.
CCDC_GUARDIAN_STATE_DIR=""         # e.g. "/var/lib/misc/.netmon"

# Independently hash and repair sentry's unit, installed config, ownership
# marker, and every regular file in its installed tree. "auto" enrolls sentry
# when guardian --install sees a valid sentry installation, remembers that
# enrollment in the guardian manifest, and otherwise permits a deliberate
# arm.sh --skip-sentry deployment. Use 0 only when another mechanism owns
# sentry integrity. Re-run sentry --install immediately before guardian
# --install when intentionally updating the sentry payload.
CCDC_GUARDIAN_PROTECT_SENTRY="auto"

# NOTE: do NOT give each chain its own CCDC_EVIDENCE_DIR. The watchdog's
# singleton lock lives there, and that shared lock is what keeps exactly one
# watchdog restarting services. Two watchdogs restarting the same service is not
# redundancy -- the second restart is an outage you caused yourself. Losing
# chains idle as hot standbys and take over within
# CCDC_WATCHDOG_STANDBY_SECONDS if the active one is killed.
CCDC_WATCHDOG_STANDBY_SECONDS="5"

# Seconds between reconcile passes. This is the window an attacker has to remove
# all three layers at once; shorter is more resilient and noisier. The cron
# layer rounds up to whole minutes, so below 60 only the systemd layers actually
# tick at this rate.
CCDC_GUARDIAN_INTERVAL="60"

# Seconds between WATCHDOG passes. Different job, different number: the interval
# above decides how fast a deleted layer is rebuilt, this one decides how fast a
# dead service is noticed, and only this one converts into scored downtime. Your
# mean outage is roughly half of it. Measured on the lab box against an external
# scorer, the same `systemctl stop` cost 57s at 60 and 6s at 5.
#
# A pass is a curl and a couple of systemctl calls, and watchdog.sh already
# limits itself to one restart per service per pass with a settle deadline after
# each, so a short interval is not a restart storm. Leave empty to inherit
# CCDC_GUARDIAN_INTERVAL. Floor is 2.
CCDC_WATCHDOG_INTERVAL="5"

# How often the watchdog writes a "still alive" line when nothing is wrong. The
# log otherwise records only state CHANGES, so a quiet hour is silent -- which
# is what makes a short interval affordable to read, but also means you need
# some proof the loop is still running.
CCDC_WATCHDOG_HEARTBEAT_SECONDS="300"

# --- Sentry (sentry.sh) -----------------------------------------------------
# arm.sh installs this as a supervised service. It runs ranked triage often,
# runs the larger canary+hunt+recon sweep less often, and keeps a CURRENT
# approval queue in $CCDC_EVIDENCE_DIR/ALERTS. It never approves its own work.
CCDC_SENTRY_NAME="ccdc-sentry"
CCDC_SENTRY_DIR=""                 # empty -> /usr/local/lib/$CCDC_SENTRY_NAME
CCDC_SENTRY_INTERVAL="60"
CCDC_WATCH_INTERVAL="120"
# Hard deadlines for one triage pass and one full canary/hunt/recon sweep.
# Without these, one wedged NSS lookup, filesystem walk, or package verifier
# could leave the sentry process "active" while its queue silently went stale.
CCDC_TRIAGE_TIMEOUT="45"
CCDC_WATCH_TIMEOUT="90"
