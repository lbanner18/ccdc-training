# Copy this file to a local path such as /tmp/ccdc-linux.env.
# Never commit the filled-in copy.

CCDC_BOX_NAME="linux-target"
CCDC_EVIDENCE_DIR="/var/tmp/ccdc-evidence"
CCDC_BACKUP_DIR="/var/backups/ccdc"

# Space-separated account names that must remain usable. Include the account
# you are using to administer the box and every scored/service account.
CCDC_ALLOWED_USERS="root"

# Space-separated explicit targets for users.sh. Leave empty until the packet
# identifies accounts that may be disabled or have passwords rotated.
CCDC_MANAGED_USERS=""
CCDC_ROTATE_USERS=""

# Space-separated systemd units that watchdog may restart.
CCDC_SYSTEMD_SERVICES=""

# One check per line, format: name|host|port. These are TCP checks.
CCDC_TCP_CHECKS=""

# One check per line, format: name|url|systemd-service. The service field may
# be empty when a failed URL should only be logged.
CCDC_HTTP_CHECKS=""

# Files whose contents should remain stable. One absolute path per line.
CCDC_HASH_FILES="/etc/ssh/sshd_config"

# Allowed inbound ports, split by protocol. Examples: "22 80 443".
CCDC_ALLOWED_TCP_PORTS="22"
CCDC_ALLOWED_UDP_PORTS=""

# Optional addresses that must be able to reach the box (scorer, Splunk,
# administrator). Keep this empty until the team packet supplies the values.
CCDC_ALLOWED_SOURCES=""

# Paths to preserve, one per line. Use absolute paths and only add what the
# packet or service actually requires.
CCDC_BACKUP_PATHS="
/etc/ssh/sshd_config
/etc/passwd
/etc/group
/etc/sudoers
"

# Firewall settings. CCDC_ALLOW_OUTBOUND=0 is safer for reverse-shell control
# but may break DNS, package updates, or a scored service. Test it in the lab.
CCDC_FIREWALL_BACKEND="auto"
CCDC_ALLOW_OUTBOUND="1"
CCDC_FIREWALL_ROLLBACK_SECONDS="60"
