# HIVESTORM (CSA, 2026-11-17) - the Windows image.
#
# Image-scored, NOT CCDC: no red team, no Quotient. The scoring engine is on the
# image; the README on the Desktop is the packet. Run order: playbooks/hivestorm.md.
#
#     mkdir C:\ProgramData\CCDC -Force | Out-Null
#     copy config\hivestorm-windows.env C:\ProgramData\CCDC\ccdc.env
#     notepad C:\ProgramData\CCDC\ccdc.env      # fill the lists FROM THE README

# --- who: copy these from the README, exactly --------------------------------------
# Every account the README names (admins and standard users) plus YOUR login.
# Administrator, Guest, DefaultAccount, WDAGUtilityAccount are built-ins: list
# Administrator; Guest should end up DISABLED (a scored item), not listed.
CCDC_ALLOWED_USERS="Administrator"
# Only the README's ADMINISTRATORS. A standard user in Administrators is a
# scored finding; triage marks it RED when this is set.
CCDC_ALLOWED_ADMINS="Administrator"
CCDC_INTERACTIVE_USERS=""

# --- what: the README's critical services -----------------------------------------
# Name each one the README requires (W3SVC, FTPSVC, LanmanServer for shares,
# TermService for RDP, DNS...) and its port. Everything else is fair to cut.
CCDC_WINDOWS_SERVICES=""
CCDC_ALLOWED_TCP_PORTS=""
CCDC_ALLOWED_UDP_PORTS=""
CCDC_TCP_CHECKS=""
CCDC_HTTP_CHECKS=""
# RDP: "1" only if the README lists Remote Desktop as required. Otherwise
# turning it off is usually a point.
CCDC_RDP_SCORED="0"

# --- password and lockout policy: the textbook values, they score -------------------
CCDC_PW_MIN_LENGTH="12"
CCDC_PW_MAX_AGE="90"
CCDC_PW_HISTORY="5"
CCDC_LOCKOUT_THRESHOLD="5"
CCDC_LOCKOUT_DURATION="30"
