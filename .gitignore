# Local box configurations and evidence are never committed.
config/*.env
!config/example.env
evidence/
backups/
*.log

# Never commit anything box-specific, even in a private repo:
# it becomes public on competition day.
*.env
!config/example.env
evidence/

# Windows tools write state under CCDC_WIN_ROOT; a stray .tmp here means a
# path bug, not something to keep.
.tmp
*.tmp
